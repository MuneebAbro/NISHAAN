<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- MaterialCardView uses checked and activated states heavily -->
    <item android:color="@color/color_ember_amber" android:state_checked="true" />
    <item android:color="@color/color_ember_amber" android:state_activated="true" />
    <item android:color="@color/color_ember_amber" android:state_selected="true" />
    <item android:color="@color/color_ember_amber" android:state_pressed="true" />
    <item android:color="@color/color_charcoal_grey" />
</selector>
