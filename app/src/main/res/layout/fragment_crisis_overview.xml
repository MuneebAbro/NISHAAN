<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_xl">

        <!-- Briefing Description Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/NishaanCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_md"
            app:cardCornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/color_divider_dark"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/descriptionText"
                style="@style/TextBodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_md"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/color_on_background_dark" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Feature 3: Predicted Spread (2hr) Card (inserted here) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSpreadPrediction"
            style="@style/NishaanCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            app:cardCornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/color_divider_dark"
            app:cardElevation="0dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Dashed circle icon or info icon -->
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="8dp"
                        android:src="@android:drawable/ic_menu_compass"
                        app:tint="@color/color_signal_red" />

                    <TextView
                        style="@style/TextHeadline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Predicted Spread (2hr)"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/spreadConfidenceChip"
                        style="@style/TextBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:textSize="9sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/spreadRadiusText"
                    style="@style/TextHeadline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="18sp"
                    android:textColor="@color/color_on_background_dark"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/spreadReasoningText"
                    style="@style/TextBodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textStyle="italic"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Feature 1: Crowd-Sourced Signal Verification Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardVerification"
            style="@style/NishaanCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            app:cardCornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/color_divider_dark"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    style="@style/TextHeadline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Is this crisis real? Help us verify."
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_on_background_dark" />

                <!-- 3 selection buttons in a row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVerifyYes"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="✅ Yes"
                        android:textSize="12sp"
                        app:strokeColor="@color/color_divider_dark" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVerifyNo"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="3dp"
                        android:text="❌ No"
                        android:textSize="12sp"
                        app:strokeColor="@color/color_divider_dark" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVerifyUnsure"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="🤷 Not Sure"
                        android:textSize="12sp"
                        app:strokeColor="@color/color_divider_dark" />
                </LinearLayout>

                <!-- Vote Result/Tally label -->
                <TextView
                    android:id="@+id/verifyTallyText"
                    style="@style/TextCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp" />

                <!-- User reported response label -->
                <TextView
                    android:id="@+id/verifyUserResponseText"
                    style="@style/TextCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textStyle="bold"
                    android:textColor="@color/color_signal_red"
                    android:textSize="12sp"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Dynamic dispatch chips -->
        <TextView
            style="@style/TextHeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/crisis_detail_agencies"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/color_on_background_dark" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/agencyChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="@dimen/spacing_md"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="8dp" />

        <!-- Linked Action Cards -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/missingPersonsCard"
            style="@style/NishaanCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            app:cardCornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/color_divider_dark"
            app:cardBackgroundColor="@color/color_charcoal_grey"
            app:cardElevation="0dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:id="@+id/missingCountText"
                    style="@style/TextBodyMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textStyle="bold"
                    android:textColor="@color/color_on_background_dark" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_more"
                    app:tint="@color/color_signal_red"
                    android:contentDescription="@null" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/color_divider_dark"
            android:layout_marginTop="@dimen/spacing_sm"
            android:layout_marginBottom="@dimen/spacing_md" />

        <!-- Agent Trace Sub-Panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="4dp">

            <TextView
                style="@style/TextHeadline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/crisis_detail_agent_trace"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/color_on_background_dark" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewFullTrace"
                style="@style/TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/crisis_detail_view_full_trace"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tracePreviewContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
