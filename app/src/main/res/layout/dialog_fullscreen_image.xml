<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialogContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F209090F"
    android:clickable="true"
    android:focusable="true">

    <!-- Fullscreen Image -->
    <ImageView
        android:id="@+id/fullscreenImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:contentDescription="Fullscreen Dossier Photo" />

    <!-- Top Status / Title Overlay (Sleek and subtle) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_search_pill"
        android:backgroundTint="#CC151515"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/txtFullscreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins"
            android:text="Dossier Photo"
            android:textColor="@color/color_on_background_dark"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />
    </LinearLayout>

    <!-- Floating Improvised Close Button -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDismiss"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="20dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        app:cardBackgroundColor="#CC151515"
        app:cardCornerRadius="22dp"
        app:strokeWidth="1dp"
        app:strokeColor="#26FFFFFF"
        app:cardElevation="6dp">

        <ImageView
            android:id="@+id/btnDismiss"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/color_on_background_dark"
            android:contentDescription="Close" />
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
