<?xml version="1.0" encoding="utf-8"?>
<!--
    NISHAAN — Missing Person Item (Redesigned)
    • MaterialCardView with subtle border — zero elevation
    • Left photo in rounded frame with overlay status indicator
    • Name + status badge row with chevron
    • Details + last seen with proper text hierarchy
    • Severity stripe on right edge for visual scanning
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/color_card_dark"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/color_divider_dark"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="14dp">

        <!-- ═══ Photo Frame with status dot overlay ═══ -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="14dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/color_divider_dark"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/photoThumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Live status indicator dot (top-right) -->
            <View
                android:id="@+id/statusDot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="top|end"

                android:background="@drawable/circle_pulse_green" />
        </FrameLayout>

        <!-- ═══ Content ═══ -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Row 1: Badge + Time -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/statusChip"
                    style="@style/TextBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="3dp"
                    android:textSize="9sp"
                    tools:text="MISSING" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/lastSeenText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:textColor="#55FFFFFF"
                    android:textSize="10sp"
                    tools:text="2d ago" />
            </LinearLayout>

            <!-- Name -->
            <TextView
                android:id="@+id/personName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:fontFamily="@font/poppins"
                android:maxLines="1"
                android:textColor="@color/color_on_background_dark"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Ahmed Khan" />

            <!-- Details (Age, Gender, etc.) -->
            <TextView
                android:id="@+id/personDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/color_chalk"
                android:textSize="12sp"
                android:fontFamily="@font/poppins"
                tools:text="Male · 32 yrs · Karachi Central" />
        </LinearLayout>

        <!-- ═══ Severity Stripe + Chevron ═══ -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <View
                android:id="@+id/severityStripe"
                android:layout_width="3dp"
                android:layout_height="36dp"
                android:layout_gravity="center_horizontal"
                android:background="@color/color_signal_red" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                app:tint="#44FFFFFF" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
