<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:orientation="vertical">

    <!-- EOC Timeline Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_xxl"
        android:paddingBottom="@dimen/spacing_md"
        android:background="?android:colorBackground">

        <TextView
            android:id="@+id/traceTitle"
            style="@style/TextDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textColor="@color/color_on_background_dark" />

        <TextView
            style="@style/TextCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/agent_trace_subtitle"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textAllCaps="true"
            android:letterSpacing="0.05"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Header Divider Line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/color_divider_dark" />

    <!-- Floating status / alert notification chip -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- New Activity chip (shown when scrolled down) -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chipNewActivity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:text="@string/agent_trace_new_activity"
            android:textColor="@color/white"
            android:visibility="gone"
            app:chipBackgroundColor="@color/color_primary"
            app:chipStrokeWidth="0dp"
            app:elevation="4dp" />
    </FrameLayout>

    <!-- Timeline RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/traceRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingBottom="@dimen/spacing_lg"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
</LinearLayout>
