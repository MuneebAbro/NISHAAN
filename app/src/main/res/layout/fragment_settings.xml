<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <!-- Header / Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/btn_back"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="?attr/colorOnBackground" />

            <TextView
                style="@style/TextDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:text="@string/profile_app_settings" />
        </LinearLayout>

        <!-- Theme Selection Section -->
        <TextView
            style="@style/TextHeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:text="@string/settings_theme_title" />

        <com.google.android.material.card.MaterialCardView
            style="@style/NishaanCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm">

            <RadioGroup
                android:id="@+id/radioGroupTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/radioThemeLight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_theme_light" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/radioThemeDark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/settings_theme_dark" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/radioThemeSystem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/settings_theme_system" />
            </RadioGroup>
        </com.google.android.material.card.MaterialCardView>

        <!-- Notification Preferences Section -->
        <TextView
            style="@style/TextHeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:text="@string/profile_notification_prefs" />

        <com.google.android.material.card.MaterialCardView
            style="@style/NishaanCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchCritical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/profile_pref_critical" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:checked="true"
                    android:text="@string/profile_pref_medium" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchLow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:checked="false"
                    android:text="@string/profile_pref_low" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchMissing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:checked="true"
                    android:text="@string/profile_pref_missing" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Language Settings Section -->
        <TextView
            style="@style/TextHeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:text="App Language" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChangeLanguage"
            style="@style/SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/profile_language_select"
            app:icon="@android:drawable/ic_menu_sort_alphabetically" />

        <!-- Sign Out -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSignOut"
            style="@style/SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:layout_marginBottom="@dimen/spacing_xxl"
            android:text="@string/btn_sign_out"
            app:icon="@android:drawable/ic_lock_power_off" />

    </LinearLayout>
</ScrollView>
