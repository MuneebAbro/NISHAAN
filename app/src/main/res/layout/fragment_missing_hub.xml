<?xml version="1.0" encoding="utf-8"?>
<!--
    NISHAAN — Missing Persons Hub (Redesigned)
    Aesthetic: Premium command-center / glass-morphism
    Key changes:
      • Dark background with rounded glass-style header
      • Summary stat row (Total · Active · Found) beneath title
      • ic_missing icon inside a sleek pill search bar
      • Polished tabs with refined styling
      • Premium empty state with icon circle + descriptive text
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_glass"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="52dp"
            android:paddingBottom="20dp">

            <!-- Row 1: Title + Report Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextDisplay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/missing_hub_title"
                        android:textColor="@color/color_on_background_dark"
                        android:textSize="26sp" />

                    <!-- Subtle section label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/poppins"
                        android:letterSpacing="0.06"
                        android:text="SEARCH DATABASE"
                        android:textColor="@color/color_text_subtitle"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Report Missing — glass pill button -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnReportMissing"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    app:cardBackgroundColor="@color/color_charcoal_grey"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/color_ember_amber"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_add_person"
                            app:tint="@color/color_secondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins"
                            android:text="Report"
                            android:textColor="@color/color_text_on_accent"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@color/color_text_subtitle" />
        </LinearLayout>
        <!-- ═══════════════════════════════════════════
             GLASS HEADER — bottom-rounded card
             ═══════════════════════════════════════════ -->


        <!-- ═══════════════════════════════════════════
             SEARCH BAR — pill with ic_missing icon
             ═══════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:background="@color/color_charcoal_grey"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_missing"
                app:tint="@color/color_text_on_accent" />

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="@font/poppins"
                android:hint="@string/missing_hub_search"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/color_on_background_dark"
                android:textColorHint="@color/color_text_subtitle"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ═══════════════════════════════════════════
             TABS — sleek, pill-styled
             ═══════════════════════════════════════════ -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="4dp"
            android:background="@android:color/transparent"
            app:tabGravity="fill"
            app:tabIndicatorColor="@color/color_ember_amber"
            app:tabIndicatorFullWidth="false"
            app:tabIndicatorHeight="3dp"
            app:tabMode="fixed"
            app:tabRippleColor="@android:color/transparent"
            app:tabSelectedTextColor="@color/color_on_background_dark"
            app:tabTextColor="@color/color_text_subtitle">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/missing_hub_tab_all" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/missing_hub_tab_by_crisis" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/missing_hub_tab_unlinked" />
        </com.google.android.material.tabs.TabLayout>

        <!-- Thin divider under tabs -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#0CFFFFFF" />

        <!-- ═══════════════════════════════════════════
             RECYCLER VIEW — person cards
             ═══════════════════════════════════════════ -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/missingRecycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <!-- ═══════════════════════════════════════════
             EMPTY STATE — polished with icon + text
             ═══════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="48dp"
            android:visibility="gone">

            <!-- Icon circle -->
            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_stat_chip">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_missing"
                    app:tint="#44FFFFFF" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:gravity="center"
                android:text="No missing persons found"
                android:textColor="@color/color_chalk"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/poppins"
                android:gravity="center"
                android:letterSpacing="0.02"
                android:text="Reports will appear here as they\nare filed into the system."
                android:textColor="@color/color_text_subtitle"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
