<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Light Theme -->
    <style name="Base.Theme.NISHAAN" parent="Theme.Material3.Light.NoActionBar">
        <!-- Brand colors -->
        <item name="colorPrimary">@color/color_signal_red</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/color_signal_red_dark</item>
        <item name="colorSecondary">@color/color_ember_amber</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorTertiary">@color/color_ops_blue</item>
        <item name="colorOnTertiary">@color/white</item>
        <!-- Surfaces -->
        <item name="android:colorBackground">@color/color_background_light</item>
        <item name="colorOnBackground">@color/color_on_background_light</item>
        <item name="colorSurface">@color/color_surface_light</item>
        <item name="colorOnSurface">@color/color_on_surface_light</item>
        <item name="colorSurfaceVariant">@color/color_surface_variant_light</item>
        <item name="colorOnSurfaceVariant">@color/color_on_surface_muted_light</item>
        <item name="colorOutlineVariant">@color/color_divider_light</item>
        <!-- Typography — Poppins everywhere -->
        <item name="android:fontFamily">@font/poppins</item>
        <item name="fontFamily">@font/poppins</item>
        <!-- System bars -->
        <item name="android:statusBarColor">@color/color_background_light</item>
        <item name="android:navigationBarColor">@color/color_surface_light</item>
        <!-- Splash Screen (Android 12+) -->
        <item name="android:windowSplashScreenBackground">@color/color_background_light</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
    <style name="Theme.NISHAAN" parent="Base.Theme.NISHAAN" />

    <!-- UCrop screen: dark bars + fitsSystemWindows to avoid overlap -->
    <style name="Theme.NISHAAN.UCrop" parent="Theme.NISHAAN">
        <item name="android:fitsSystemWindows">true</item>
        <item name="android:statusBarColor">@color/color_background_dark</item>
        <item name="android:navigationBarColor">@color/color_background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>